# Copy to .env for local development, then: source .env
#
# Ports match deploy/docker-compose.yml, which uses non-default host ports so
# this project does not collide with any Postgres or Redis already installed on
# the machine.

# --- Database (required, no default) ---
DATABASE_DSN=postgres://cleargate:cleargate@localhost:5432/cleargate?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=2
DATABASE_CONNECT_TIMEOUT=10s

# --- Cache ---
CACHE_ADDR=localhost:6380
CACHE_PASSWORD=
CACHE_DB=0

# --- Server ---
SERVER_ADDR=:8080
SERVER_MODE=debug
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_SHUTDOWN_TIMEOUT=15s
# Comma-separated addresses or CIDR ranges of the load balancers in front of
# the API. Only their X-Forwarded-For is believed. Empty trusts nobody and uses
# the connection's address, which is right with no proxy and wrong behind one
# (every client would share the proxy's rate limit).
SERVER_TRUSTED_PROXIES=

# --- Rate limits, requests per minute ---
# Public routes (sign-up, login, password reset), per client address.
RATE_LIMIT_PUBLIC_PER_MINUTE=30
# The agent surface, per agent.
RATE_LIMIT_AGENT_PER_MINUTE=600
# The console surface, per signed-in person.
RATE_LIMIT_CONSOLE_PER_MINUTE=300

# --- Encryption (required, no default) ---
#
# Master keys for the few secrets the server must read back rather than merely
# compare, such as a TOTP shared secret. Format is a comma-separated list of
# id:base64key, so a key can be rotated without a migration: the id travels in
# every ciphertext, and a retired key stays loaded until nothing references it.
#
# Generate one with:  openssl rand -base64 32
#
# Never reuse a key across environments. A shared key means a staging database
# dump is enough to recover every production second factor.
CRYPTO_MASTER_KEYS=1:REPLACE_ME_WITH_OPENSSL_RAND_BASE64_32
CRYPTO_ACTIVE_KEY_ID=1

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=text

# How the API sends email (verification, password reset, invitations). No
# default. "log" writes the links to the log instead, which hands out working
# credentials, so it is accepted only with SERVER_MODE=debug.
MAIL_TRANSPORT=log
# Where emailed links point.
CONSOLE_URL=http://localhost:3000

# --- Coinbase CDP (account wallets, Task 7.5) ---
#
# CDP holds account wallets' keys as Server Wallets and signs on request; no
# private key is held here. Create the API key under API Keys, Secret API Keys
# (Ed25519), and the wallet secret under the wallet dashboard's Security
# section, at https://portal.cdp.coinbase.com. Both secrets are shown once.
#
# The wallet secret is what authorizes creating wallets and signing, which is
# why it is separate: the API key alone can read but not move money.
#
# Use a CDP project of its own for development, so these keys can never reach
# a mainnet wallet. No default. The API refuses to start without them. The
# worker does not read them: it never signs. The CDP integration tests skip
# without them.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# --- Solana (deposits, payments and their confirmation) ---
#
# Which chain money moves on and which token is money there. All four default
# to devnet, so reaching mainnet takes setting every one of them on purpose.
# The public devnet endpoint rate-limits hard: use a provider's URL for anything
# longer than a quick test. It must serve SOLANA_NETWORK.
SOLANA_RPC_URL=https://api.devnet.solana.com
# CAIP-2 chain id.
SOLANA_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
# The only token accepted. Its decimals turn atomic units into USD, and are
# never taken from anything a merchant sends.
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
SOLANA_USDC_DECIMALS=6
